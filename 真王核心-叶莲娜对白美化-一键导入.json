{"id":"true-king-yelena-dialogue-v1","scriptName":"真王核心-叶莲娜对白美化","disabled":false,"runOnEdit":true,"findRegex":"/<yelena\\b(?=[^>]*\\bname=[\"']([^\"']+)[\"'])(?=[^>]*\\bmood=[\"']([^\"']+)[\"'])(?=[^>]*\\btype=[\"']([^\"']+)[\"'])[^>]*>\\s*([\\s\\S]*?)\\s*<\\/yelena>/gi","trimStrings":[],"replaceString":"<div class=\"tk-yelena-dialogue type-$3 mood-$2\"><div class=\"tk-yelena-stardust dust-a\" aria-hidden=\"true\"></div><div class=\"tk-yelena-stardust dust-b\" aria-hidden=\"true\"></div><div class=\"tk-yelena-stardust dust-c\" aria-hidden=\"true\"></div><div class=\"tk-yelena-feathers\" aria-hidden=\"true\"></div><div class=\"tk-yelena-pillow\" aria-hidden=\"true\"></div><div class=\"tk-yelena-header\"><span class=\"tk-yelena-header-line\"></span><span class=\"tk-yelena-name\">$1</span><span class=\"tk-yelena-header-line\"></span></div><div class=\"tk-yelena-state\">$3 · $2</div><div class=\"tk-yelena-content\"><div class=\"tk-yelena-avatar-area\" aria-hidden=\"true\"><div class=\"tk-yelena-avatar\"></div><div class=\"tk-yelena-avatar-frame\"></div></div><div class=\"tk-yelena-body\">$4</div></div><div class=\"tk-yelena-signature\">in somnis, veritas</div></div><style>@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Noto+Serif+SC:wght@400;500;600&display=swap');\n\n/*\n * 叶莲娜对白美化\n * 标签：<yelena name=\"叶莲娜\" mood=\"懒散\" type=\"现实\">……</yelena>\n *\n * 资源接口：正式发布时只需将下方 5 个 url 替换为图床地址。\n * mood 头像接口已经全部保留；目前没有表情差分，因此共同回退到基础头像。\n */\n\n.tk-yelena-dialogue {\n  --yelena-velvet: url('https://files.catbox.moe/poa9s2.png');\n  --yelena-feathers: url('https://files.catbox.moe/qwaeeh.png');\n  --yelena-pillow: url('https://files.catbox.moe/r8kjmp.png');\n  --yelena-avatar-default: url('https://i.ibb.co/QjmXCKby/yelena-avatar-lazy-v1.png');\n  --yelena-avatar-alt: url('https://i.ibb.co/h1LQqZGV/yelena-avatar-disdain-v1.png');\n  --yelena-avatar-lazy: url('https://i.ibb.co/QjmXCKby/yelena-avatar-lazy-v1.png');\n  --yelena-avatar-snark: url('https://i.ibb.co/Gvxm0YGV/yelena-avatar-snark-v1.png');\n  --yelena-avatar-excited: url('https://i.ibb.co/Jjb9dRWS/yelena-avatar-excited-v1.png');\n  --yelena-avatar-disdain: url('https://i.ibb.co/h1LQqZGV/yelena-avatar-disdain-v1.png');\n  --yelena-avatar-smirk: url('https://i.ibb.co/3m2HB97N/yelena-avatar-smirk-v1.png');\n  --yelena-avatar-serious: url('https://i.ibb.co/XZngQ0SQ/yelena-avatar-serious-v1.png');\n  --yelena-avatar-surprised: url('https://i.ibb.co/MxhjhRS2/yelena-avatar-surprised-v1.png');\n  --yelena-avatar-shy: url('https://i.ibb.co/SDVLyPGH/yelena-avatar-shy-v1.png');\n  --yelena-avatar-sleepy: url('https://i.ibb.co/gLNy2WJy/yelena-avatar-sleepy-v1.png');\n  --yelena-avatar-content: url('https://i.ibb.co/BHhxPWpb/yelena-avatar-content-v1.png');\n  --yelena-avatar: var(--yelena-avatar-default);\n  --yelena-star-strength: 0.54;\n  --yelena-haze-strength: 0.34;\n  --yelena-accent: #d8c9ff;\n  --yelena-accent-strong: #eee8ff;\n  --yelena-muted: #998ab9;\n  --yelena-ink: #ece8f7;\n  --yelena-panel: rgba(20, 11, 33, 0.34);\n\n  isolation: isolate;\n  position: relative;\n  width: min(100%, 1040px);\n  min-height: 180px;\n  box-sizing: border-box;\n  margin: 26px auto 21px;\n  padding: 24px 38px 14px;\n  overflow: hidden;\n  color: var(--yelena-ink);\n  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', serif;\n  background:\n    linear-gradient(112deg, rgba(13, 7, 23, 0.9), rgba(55, 35, 73, 0.5) 42%, rgba(17, 9, 28, 0.93)),\n    var(--yelena-velvet) center / 520px 520px repeat;\n  border: 0;\n  border-radius: 18px;\n  box-shadow:\n    0 18px 42px rgba(5, 1, 12, 0.62),\n    0 0 24px rgba(117, 91, 160, 0.2),\n    inset 0 0 55px rgba(8, 3, 17, 0.76),\n    inset 0 1px rgba(255, 255, 255, 0.08);\n}\n\n.tk-yelena-dialogue::before {\n  content: '';\n  position: absolute;\n  z-index: 0;\n  inset: -1px;\n  pointer-events: none;\n  border-radius: inherit;\n  background:\n    radial-gradient(ellipse at 17% 28%, rgba(171, 133, 226, 0.2), transparent 36%),\n    radial-gradient(ellipse at 78% 66%, rgba(103, 91, 174, 0.17), transparent 42%),\n    linear-gradient(95deg, transparent 4%, rgba(235, 225, 255, 0.045) 49%, transparent 76%);\n  animation: yelena-dream-haze 9s ease-in-out infinite alternate;\n}\n\n.tk-yelena-dialogue::after {\n  content: '';\n  position: absolute;\n  z-index: 5;\n  inset: 12px 28px;\n  pointer-events: none;\n  background:\n    linear-gradient(90deg, transparent 0%, rgba(237, 205, 235, 0.35) 6%, #f1d7ee 18%, #c5a8dc 50%, #f1d7ee 82%, rgba(237, 205, 235, 0.35) 94%, transparent 100%) top center / 100% 1px no-repeat,\n    linear-gradient(90deg, transparent 0%, rgba(237, 205, 235, 0.25) 7%, #d8b9df 20%, #b797cf 50%, #d8b9df 80%, rgba(237, 205, 235, 0.25) 93%, transparent 100%) bottom center / 100% 1px no-repeat;\n  background-size: 100% 1px, 100% 1px;\n  filter: drop-shadow(0 0 4px rgba(239, 199, 232, 0.58));\n}\n\n.tk-yelena-dialogue.type-梦境 {\n  --yelena-star-strength: 0.86;\n  --yelena-haze-strength: 0.62;\n  --yelena-accent: #e2d4ff;\n  --yelena-panel: rgba(27, 15, 43, 0.38);\n  box-shadow:\n    0 18px 46px rgba(5, 1, 12, 0.68),\n    0 0 34px rgba(142, 111, 198, 0.32),\n    inset 0 0 64px rgba(8, 3, 17, 0.72),\n    inset 0 1px rgba(255, 255, 255, 0.1);\n}\n\n.tk-yelena-dialogue.type-现实 {\n  --yelena-star-strength: 0.44;\n  --yelena-haze-strength: 0.26;\n}\n\n/* 三层星尘只改变 opacity / transform，避免在酒馆聊天记录中造成高负载。 */\n.tk-yelena-stardust {\n  position: absolute;\n  z-index: 1;\n  inset: 12px 18px;\n  pointer-events: none;\n  opacity: calc(var(--yelena-star-strength) * 0.7);\n  background-repeat: no-repeat;\n  will-change: opacity, transform;\n}\n\n.tk-yelena-stardust.dust-a {\n  background-image:\n    radial-gradient(circle, #fff 0 1px, transparent 1.7px),\n    radial-gradient(circle, #e7dbff 0 1.2px, transparent 2px),\n    radial-gradient(circle, #fff 0 0.8px, transparent 1.5px),\n    radial-gradient(circle, #cbb9ee 0 1px, transparent 2px),\n    radial-gradient(circle, #fff 0 1.1px, transparent 1.8px),\n    radial-gradient(circle, #d9ccf5 0 0.8px, transparent 1.6px);\n  background-position: 7% 22%, 23% 72%, 47% 17%, 63% 83%, 78% 26%, 94% 62%;\n  animation: yelena-twinkle-a 4.8s ease-in-out infinite alternate;\n}\n\n.tk-yelena-stardust.dust-b {\n  inset: 20px 40px 30px;\n  background-image:\n    radial-gradient(circle, #fff 0 0.8px, transparent 1.7px),\n    radial-gradient(circle, #c9b5ed 0 1px, transparent 2px),\n    radial-gradient(circle, #f8f4ff 0 1.2px, transparent 2.1px),\n    radial-gradient(circle, #fff 0 0.7px, transparent 1.5px),\n    radial-gradient(circle, #d6c8f1 0 1px, transparent 1.8px);\n  background-position: 15% 58%, 36% 33%, 56% 72%, 73% 48%, 88% 14%;\n  animation: yelena-twinkle-b 6.4s 1.1s ease-in-out infinite alternate;\n}\n\n.tk-yelena-stardust.dust-c {\n  inset: 8px 8px 22px;\n  background-image:\n    radial-gradient(circle, rgba(255,255,255,.95) 0 1px, transparent 2.2px),\n    radial-gradient(circle, rgba(216,198,247,.95) 0 1.2px, transparent 2.5px),\n    radial-gradient(circle, rgba(255,255,255,.9) 0 0.9px, transparent 2px),\n    radial-gradient(circle, rgba(188,169,224,.95) 0 1px, transparent 2.2px);\n  background-position: 4% 78%, 31% 12%, 69% 21%, 96% 38%;\n  filter: drop-shadow(0 0 3px rgba(222, 207, 255, 0.8));\n  animation: yelena-star-drift 11s linear infinite;\n}\n\n.tk-yelena-feathers,\n.tk-yelena-pillow {\n  position: absolute;\n  z-index: 2;\n  pointer-events: none;\n  background-repeat: no-repeat;\n  background-size: contain;\n  opacity: 0.42;\n}\n\n.tk-yelena-feathers {\n  left: -30px;\n  bottom: -58px;\n  width: 46%;\n  height: 72%;\n  background-image: var(--yelena-feathers);\n  background-position: left bottom;\n  transform: rotate(-2deg);\n}\n\n.tk-yelena-pillow {\n  right: -48px;\n  bottom: -54px;\n  width: 34%;\n  height: 61%;\n  background-image: var(--yelena-pillow);\n  background-position: right bottom;\n  opacity: 0.3;\n}\n\n.tk-yelena-header,\n.tk-yelena-content,\n.tk-yelena-signature {\n  position: relative;\n  z-index: 4;\n}\n\n.tk-yelena-header {\n  position: absolute;\n  top: 15px;\n  left: 30%;\n  right: 27%;\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: 13px;\n  margin: 0;\n}\n\n.tk-yelena-header-line {\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(203, 185, 231, 0.46));\n}\n\n.tk-yelena-header-line:last-child {\n  transform: scaleX(-1);\n}\n\n.tk-yelena-name {\n  color: var(--yelena-accent-strong);\n  font-family: 'Cinzel', 'Noto Serif SC', serif;\n  font-size: 1.18em;\n  font-weight: 600;\n  letter-spacing: 0.28em;\n  text-shadow: 0 0 12px rgba(197, 174, 239, 0.56);\n}\n\n.tk-yelena-name::before,\n.tk-yelena-name::after {\n  color: rgba(215, 200, 242, 0.67);\n  font-size: 0.66em;\n  text-shadow: 0 0 8px rgba(215, 200, 242, 0.68);\n}\n\n.tk-yelena-name::before { content: '☾'; margin-right: 10px; }\n.tk-yelena-name::after { content: '✦'; margin-left: 7px; }\n\n.tk-yelena-state {\n  position: absolute;\n  z-index: 6;\n  top: 14px;\n  right: 38px;\n  max-width: calc(100% - 86px);\n  padding: 4px 11px 5px;\n  color: #d9ccef;\n  font-size: 0.67em;\n  letter-spacing: 0.18em;\n  white-space: nowrap;\n  background: linear-gradient(135deg, rgba(92, 67, 119, 0.72), rgba(35, 20, 52, 0.88));\n  border: 1px solid rgba(207, 187, 238, 0.3);\n  border-radius: 999px;\n  box-shadow: 0 0 12px rgba(145, 112, 190, 0.24), inset 0 1px rgba(255,255,255,.08);\n}\n\n.type-梦境 .tk-yelena-state {\n  color: #f0e9ff;\n  border-color: rgba(222, 205, 249, 0.48);\n  box-shadow: 0 0 15px rgba(178, 137, 231, 0.42), inset 0 1px rgba(255,255,255,.12);\n  animation: yelena-moon-breathe 4.2s ease-in-out infinite;\n}\n\n.tk-yelena-content {\n  display: grid;\n  grid-template-columns: 116px minmax(0, 1fr);\n  align-items: center;\n  gap: 18px;\n  width: 100%;\n  min-height: 112px;\n  padding-top: 27px;\n  padding-bottom: 2px;\n  box-sizing: border-box;\n}\n\n.tk-yelena-avatar-area {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: 112px;\n  height: 112px;\n}\n\n.tk-yelena-avatar-area::before {\n  content: '';\n  position: absolute;\n  z-index: 0;\n  inset: 14px;\n  border-radius: 50%;\n  box-shadow:\n    0 0 25px rgba(241, 190, 225, 0.21),\n    0 0 52px rgba(192, 144, 211, 0.13);\n}\n\n.tk-yelena-avatar-area::after {\n  content: '';\n  position: absolute;\n  z-index: 4;\n  left: 0;\n  bottom: 0;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: linear-gradient(145deg, #fff0f5 4%, #f0bedb 44%, #b780b1 100%);\n  -webkit-mask: radial-gradient(circle at 68% 34%, transparent 0 43%, #000 45%);\n  mask: radial-gradient(circle at 68% 34%, transparent 0 43%, #000 45%);\n  filter:\n    drop-shadow(0 0 4px rgba(255, 216, 239, 0.95))\n    drop-shadow(0 0 9px rgba(220, 163, 211, 0.62));\n  transform: rotate(-18deg);\n}\n\n.tk-yelena-avatar {\n  grid-area: 1 / 1;\n  z-index: 1;\n  width: 98px;\n  height: 98px;\n  border-radius: 50%;\n  background-image:\n    linear-gradient(rgba(31, 18, 45, 0.03), rgba(18, 8, 28, 0.18)),\n    var(--yelena-avatar);\n  background-position: center, 50% 12%;\n  background-repeat: no-repeat;\n  background-size: cover, 238%;\n  box-shadow:\n    0 0 0 2px rgba(255, 227, 242, 0.22),\n    0 0 18px rgba(225, 173, 215, 0.3);\n}\n\n.tk-yelena-avatar-frame {\n  grid-area: 1 / 1;\n  position: relative;\n  z-index: 3;\n  width: 112px;\n  height: 112px;\n  pointer-events: none;\n  background: transparent;\n  border: 2px solid rgba(249, 205, 231, 0.82);\n  border-radius: 50%;\n  box-shadow:\n    0 0 5px rgba(255, 222, 241, 0.88),\n    0 0 13px rgba(240, 180, 220, 0.48),\n    inset 0 0 8px rgba(255, 222, 241, 0.22);\n}\n\n.tk-yelena-avatar-frame::before {\n  content: '';\n  position: absolute;\n  inset: -6px;\n  border: 1px solid rgba(238, 191, 223, 0.44);\n  border-right-color: rgba(255, 225, 242, 0.82);\n  border-bottom-color: transparent;\n  border-radius: 50%;\n  transform: rotate(-22deg);\n  box-shadow: 0 0 10px rgba(220, 161, 209, 0.2);\n}\n\n.tk-yelena-avatar-frame::after {\n  content: '✦';\n  position: absolute;\n  top: 4px;\n  right: 6px;\n  color: #ffe7f3;\n  font-size: 13px;\n  line-height: 1;\n  text-shadow: 0 0 7px rgba(255, 207, 235, 0.95);\n}\n\n/* 表情差分接口：素材补齐后，仅替换对应变量即可。 */\n.tk-yelena-dialogue.mood-懒散 { --yelena-avatar: var(--yelena-avatar-lazy, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-吐槽 { --yelena-avatar: var(--yelena-avatar-snark, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-兴奋 { --yelena-avatar: var(--yelena-avatar-excited, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-嫌弃 { --yelena-avatar: var(--yelena-avatar-disdain, var(--yelena-avatar-alt)); }\n.tk-yelena-dialogue.mood-坏笑 { --yelena-avatar: var(--yelena-avatar-smirk, var(--yelena-avatar-alt)); }\n.tk-yelena-dialogue.mood-认真 { --yelena-avatar: var(--yelena-avatar-serious, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-惊讶 { --yelena-avatar: var(--yelena-avatar-surprised, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-害羞 { --yelena-avatar: var(--yelena-avatar-shy, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-困倦 { --yelena-avatar: var(--yelena-avatar-sleepy, var(--yelena-avatar-default)); }\n.tk-yelena-dialogue.mood-满足 { --yelena-avatar: var(--yelena-avatar-content, var(--yelena-avatar-default)); }\n\n.tk-yelena-body {\n  position: relative;\n  min-width: 0;\n  padding: 14px 22px 14px 24px;\n  color: #eee8f6;\n  font-size: 1.04em;\n  line-height: 1.72;\n  text-align: left;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  background: rgba(20, 11, 33, 0.34);\n  border-left: 2px solid rgba(207, 187, 238, 0.62);\n  border-radius: 0 12px 12px 0;\n  box-shadow: inset 0 0 20px rgba(10, 4, 17, 0.16);\n  text-shadow: 0 1px 2px rgba(3, 1, 8, 0.9);\n}\n\n.tk-yelena-body::before {\n  content: none;\n}\n\n.tk-yelena-signature {\n  position: relative;\n  margin: 1px 8px 0 134px;\n  color: rgba(190, 174, 216, 0.56);\n  font-family: 'Cinzel', Georgia, serif;\n  font-size: 0.74em;\n  font-style: italic;\n  font-weight: 500;\n  letter-spacing: 0.22em;\n  text-align: right;\n  text-shadow: 0 0 8px rgba(158, 126, 201, 0.36);\n  transition: color 500ms ease, text-shadow 500ms ease;\n}\n\n.tk-yelena-dialogue:hover .tk-yelena-signature {\n  color: rgba(222, 209, 243, 0.82);\n  text-shadow: 0 0 12px rgba(185, 151, 226, 0.58);\n}\n\n@keyframes yelena-twinkle-a {\n  0%, 18% { opacity: calc(var(--yelena-star-strength) * 0.28); transform: translate3d(0, 1px, 0); }\n  52% { opacity: var(--yelena-star-strength); }\n  100% { opacity: calc(var(--yelena-star-strength) * 0.48); transform: translate3d(1px, -2px, 0); }\n}\n\n@keyframes yelena-twinkle-b {\n  0% { opacity: calc(var(--yelena-star-strength) * 0.65); transform: translate3d(0, -1px, 0); }\n  43% { opacity: calc(var(--yelena-star-strength) * 0.18); }\n  100% { opacity: calc(var(--yelena-star-strength) * 0.9); transform: translate3d(-2px, 2px, 0); }\n}\n\n@keyframes yelena-star-drift {\n  0% { opacity: calc(var(--yelena-star-strength) * 0.2); transform: translate3d(-3px, 3px, 0); }\n  38% { opacity: calc(var(--yelena-star-strength) * 0.82); }\n  72% { opacity: calc(var(--yelena-star-strength) * 0.35); }\n  100% { opacity: calc(var(--yelena-star-strength) * 0.2); transform: translate3d(5px, -5px, 0); }\n}\n\n@keyframes yelena-dream-haze {\n  from { opacity: calc(var(--yelena-haze-strength) * 0.58); transform: translate3d(-1.5%, 0, 0) scale(1.02); }\n  to { opacity: var(--yelena-haze-strength); transform: translate3d(1.5%, -1%, 0) scale(1.05); }\n}\n\n@keyframes yelena-moon-breathe {\n  0%, 100% { filter: brightness(0.9); transform: translateY(0); }\n  50% { filter: brightness(1.15); transform: translateY(-1px); }\n}\n\n@media only screen and (max-width: 600px) {\n  .tk-yelena-dialogue {\n    min-height: 0;\n    margin: 22px 7px 18px;\n    padding: 26px 18px 20px;\n    border-radius: 19px 10px 21px 11px;\n  }\n\n  .tk-yelena-dialogue::after {\n    inset: 10px 16px;\n  }\n\n  .tk-yelena-header {\n    position: relative;\n    top: auto;\n    left: auto;\n    right: auto;\n    margin: 0 10px 14px;\n  }\n\n  .tk-yelena-name {\n    font-size: 0.96em;\n    letter-spacing: 0.2em;\n  }\n\n  .tk-yelena-state {\n    position: relative;\n    top: auto;\n    right: auto;\n    z-index: 4;\n    width: fit-content;\n    max-width: 100%;\n    margin: -5px auto 12px;\n  }\n\n  .tk-yelena-content {\n    grid-template-columns: 1fr;\n    justify-items: center;\n    gap: 7px;\n    height: auto;\n    min-height: 0;\n    padding: 0;\n  }\n\n  .tk-yelena-avatar-area {\n    width: 108px;\n    height: 108px;\n  }\n\n  .tk-yelena-avatar {\n    width: 80px;\n    height: 80px;\n  }\n\n  .tk-yelena-avatar-frame {\n    width: 98px;\n    height: 98px;\n  }\n\n  .tk-yelena-avatar-frame::before {\n    inset: -6px;\n  }\n\n  .tk-yelena-avatar-area::after {\n    left: 0;\n    bottom: 0;\n    width: 34px;\n    height: 34px;\n  }\n\n  .tk-yelena-body {\n    width: 100%;\n    box-sizing: border-box;\n    padding: 12px 12px 11px;\n    font-size: 0.95em;\n    line-height: 1.75;\n    border-left: 0;\n    border-top: 1px solid rgba(202, 181, 237, 0.48);\n    border-radius: 11px;\n  }\n\n  .tk-yelena-body::before { left: 5px; }\n\n  .tk-yelena-signature {\n    margin: 10px 0 0;\n    font-size: 0.63em;\n    letter-spacing: 0.14em;\n    text-align: center;\n  }\n\n  .tk-yelena-feathers,\n  .tk-yelena-pillow { display: none; }\n\n  .tk-yelena-stardust.dust-b { opacity: calc(var(--yelena-star-strength) * 0.42); }\n  .tk-yelena-stardust.dust-c { display: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tk-yelena-dialogue::before,\n  .tk-yelena-stardust,\n  .type-梦境 .tk-yelena-state {\n    animation: none !important;\n  }\n}</style>","placement":[2],"substituteRegex":0,"minDepth":null,"maxDepth":null,"markdownOnly":true,"promptOnly":false}