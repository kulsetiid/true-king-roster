{
  "id": "true-king-jiyue-dialogue-v2",
  "scriptName": "真王核心-姬月对白美化",
  "disabled": false,
  "runOnEdit": true,
  "findRegex": "/<jimoon\\b(?=[^>]*\\bname=[\"']([^\"']+)[\"'])(?=[^>]*\\bmood=[\"']([^\"']+)[\"'])[^>]*>\\s*(?:姬月\\s*[:：]\\s*)?([\\s\\S]*?)\\s*<\\/jimoon>/gi",
  "trimStrings": [],
  "replaceString": "<div class=\"tk-jiyue-v2 mood-$2\">\n  <div class=\"tk-jiyue-v2-paper\">\n    <span class=\"tk-jiyue-v2-tape tk-jiyue-v2-tape-a\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-tape tk-jiyue-v2-tape-b\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-thorn\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-helper tk-jiyue-v2-helper-startled\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-helper tk-jiyue-v2-helper-candy\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-helper tk-jiyue-v2-helper-sleep\" aria-hidden=\"true\"></span>\n    <span class=\"tk-jiyue-v2-helper tk-jiyue-v2-helper-repair\" aria-hidden=\"true\"></span>\n    <header class=\"tk-jiyue-v2-header\">\n      <span class=\"tk-jiyue-v2-rule\" aria-hidden=\"true\"></span>\n      <span class=\"tk-jiyue-v2-name\">$1</span>\n      <span class=\"tk-jiyue-v2-rule\" aria-hidden=\"true\"></span>\n    </header>\n    <div class=\"tk-jiyue-v2-content\">\n      <div class=\"tk-jiyue-v2-portrait\" aria-hidden=\"true\">\n        <div class=\"tk-jiyue-v2-portrait-clip\">\n          <span class=\"tk-jiyue-v2-avatar\"></span>\n        </div>\n        <span class=\"tk-jiyue-v2-frame\"></span>\n      </div>\n      <div class=\"tk-jiyue-v2-dialogue\">$3</div>\n    </div>\n    <footer class=\"tk-jiyue-v2-footer\">\n      <span class=\"tk-jiyue-v2-foot-rule\"></span>\n      <span class=\"tk-jiyue-v2-promise\">Tibi semper adero.</span>\n    </footer>\n  </div>\n</div>\n<style>\n.tk-jiyue-v2 {\n  --jy-cinnabar: #8f2d27; --jy-cinnabar-dark: #70221f; --jy-brown: #554334;\n  --jy-paper: #ead7aa; --jy-thread: #8b4a3f; --jy-dialogue-text: #7f211d;\n  --jy-frame: url(\"https://files.catbox.moe/oh1lqb.png\"); --jy-thorn: url(\"https://files.catbox.moe/cqs9ro.png\");\n  --jy-helper-sprite: url(\"https://files.catbox.moe/orpthv.webp\"); --jy-avatar: url(\"https://files.catbox.moe/doavok.png\");\n  position: relative; isolation: isolate; box-sizing: border-box;\n  width: min(100%, 1060px); margin: 12.5px auto; padding: 5.5px 11px;\n  color: var(--jy-cinnabar);\n  font-family: 'LXGW WenKai','霞鹜文楷','Kaiti SC','STKaiti','KaiTi',serif;\n  border: 1px solid rgba(97,72,49,.5); border-radius: 7px;\n  background:\n    repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 2px,transparent 2px 7px),\n    repeating-linear-gradient(92deg,rgba(43,30,22,.045) 0 1px,transparent 1px 5px),\n    linear-gradient(105deg,#6b5948,#8d785e 22%,#75614d 57%,#9a8467 82%,#665341);\n  box-shadow: 0 17px 34px rgba(18,13,10,.38),inset 0 1px rgba(255,255,255,.18),inset 0 -1px rgba(39,27,19,.45);\n}\n.tk-jiyue-v2-paper {\n  position: relative; box-sizing: border-box; min-height: 119px; padding: 17px 48px 36px; overflow: hidden;\n  clip-path: polygon(.7% 3%,4% .9%,14% 1.7%,28% .4%,42% 1.3%,57% .3%,72% 1.5%,87% .5%,99% 2.6%,99.5% 19%,98.9% 38%,99.5% 58%,98.8% 78%,99.2% 97%,86% 99%,70% 98.3%,54% 99.4%,37% 98.2%,21% 99.2%,1% 97%,.4% 78%,1% 57%,.4% 37%,1% 18%);\n  background:\n    radial-gradient(ellipse at 18% 12%,rgba(255,255,255,.44),transparent 37%),\n    radial-gradient(ellipse at 84% 82%,rgba(126,80,37,.12),transparent 38%),\n    linear-gradient(90deg,rgba(109,70,36,.11),transparent 4%,transparent 95%,rgba(102,65,34,.13)),\n    repeating-linear-gradient(0deg,transparent 0 31px,rgba(130,87,50,.095) 31px 32px),\n    repeating-linear-gradient(88deg,rgba(90,58,31,.024) 0 1px,transparent 1px 6px),var(--jy-paper);\n  box-shadow: inset 0 0 43px rgba(94,57,29,.22),inset 0 1px rgba(255,255,255,.58),0 3px 6px rgba(27,19,13,.3);\n}\n.tk-jiyue-v2-paper::before,.tk-jiyue-v2-paper::after { content:''; position:absolute; z-index:1; pointer-events:none; }\n.tk-jiyue-v2-paper::before { inset:14px 18px; border:1px solid rgba(128,82,43,.17); box-shadow:inset 0 0 15px rgba(255,249,226,.23); }\n.tk-jiyue-v2-paper::after {\n  left:29px; right:29px; bottom:19px; height:14px; opacity:.78; border-bottom:1.4px solid var(--jy-thread);\n  background:repeating-linear-gradient(90deg,transparent 0 13px,var(--jy-thread) 13px 14px,transparent 14px 24px),repeating-linear-gradient(135deg,transparent 0 7px,rgba(112,55,48,.8) 7px 8px,transparent 8px 16px) 0 10px/24px 5px repeat-x;\n}\n.tk-jiyue-v2-tape { position:absolute; z-index:7; width:89px; height:24px; pointer-events:none; opacity:.58; background:repeating-linear-gradient(90deg,rgba(109,84,54,.08) 0 1px,transparent 1px 4px),rgba(225,208,163,.78); box-shadow:0 1px 2px rgba(75,49,27,.16); }\n.tk-jiyue-v2-tape-a { top:2px; left:11%; transform:rotate(-3deg); }\n.tk-jiyue-v2-tape-b { right:7%; bottom:5px; transform:rotate(4deg); }\n.tk-jiyue-v2-header,.tk-jiyue-v2-content,.tk-jiyue-v2-footer { position:relative; z-index:5; }\n.tk-jiyue-v2-header { display:grid; grid-template-columns:minmax(42px,1fr) auto minmax(42px,1fr); align-items:center; gap:17px; width:min(70%,630px); margin:0 auto 8.5px; }\n.tk-jiyue-v2-rule { height:1px; background:linear-gradient(90deg,transparent,rgba(143,45,39,.62)); }\n.tk-jiyue-v2-rule:last-child { transform:scaleX(-1); }\n.tk-jiyue-v2-name { color:var(--jy-cinnabar); font-size:1.28em; font-weight:650; letter-spacing:.42em; text-indent:.42em; white-space:nowrap; text-shadow:0 1px rgba(255,255,255,.42),0 0 13px rgba(143,45,39,.09); }\n.tk-jiyue-v2-content { display:grid; grid-template-columns:160px minmax(0,1fr); align-items:center; gap:18px; min-height:73px; }\n.tk-jiyue-v2-portrait { position:relative; width:140px; height:140px; margin-inline:auto; filter:drop-shadow(0 5px 6px rgba(44,30,21,.29)); }\n.tk-jiyue-v2-portrait-clip { position:absolute; z-index:1; inset:14px; overflow:hidden; border-radius:50%; background:#6f543d; box-shadow:inset 0 0 12px rgba(47,30,18,.42); }\n.tk-jiyue-v2-avatar,.tk-jiyue-v2-frame { position:absolute; inset:0; pointer-events:none; background-repeat:no-repeat; }\n.tk-jiyue-v2-avatar { z-index:3; background-image:var(--jy-avatar); background-position:center; background-size:cover; }\n.tk-jiyue-v2-frame { z-index:4; background-image:var(--jy-frame); background-position:center; background-size:contain; }\n.tk-jiyue-v2-dialogue {\n  position:relative; display:flex; align-items:center; min-width:0; min-height:44px; padding:9px 24px 10px 28px; color:var(--jy-dialogue-text) !important; -webkit-text-fill-color:var(--jy-dialogue-text) !important; font-size:1.08em; font-weight:700; line-height:1.92; letter-spacing:.035em;\n  white-space:pre-wrap; overflow-wrap:anywhere; border:1px solid rgba(112,67,55,.36); border-left:2px solid rgba(205,83,70,.72); border-radius:3px;\n  background:linear-gradient(100deg,rgba(27,22,20,.27),rgba(37,30,26,.21) 76%,rgba(25,20,18,.15));\n  -webkit-backdrop-filter:blur(.7px) saturate(.9); backdrop-filter:blur(.7px) saturate(.9);\n  box-shadow:inset 0 1px rgba(255,240,218,.14),0 4px 12px rgba(47,28,18,.1);\n  text-shadow:0 1px 0 rgba(255,244,218,.48),0 0 1px rgba(67,12,10,.48);\n}\n.tk-jiyue-v2-dialogue * { color:var(--jy-dialogue-text) !important; -webkit-text-fill-color:var(--jy-dialogue-text) !important; opacity:1 !important; text-shadow:inherit !important; }\n.tk-jiyue-v2-dialogue::before { content:'“'; position:absolute; top:-25px; left:9px; color:rgba(226,123,111,.28); font-family:Georgia,serif; font-size:5em; line-height:1; }\n.tk-jiyue-v2-thorn { position:absolute; z-index:2; top:50%; right:8%; width:clamp(260px,37vw,470px); aspect-ratio:1; pointer-events:none; opacity:.07; transform:translateY(-45%) rotate(-7deg); background:var(--jy-thorn) center/contain no-repeat; filter:sepia(.32) saturate(.7); }\n.tk-jiyue-v2-footer { display:flex; align-items:center; justify-content:flex-end; gap:16px; min-height:11px; margin:6px 91px 0 178px; }\n.tk-jiyue-v2-foot-rule { flex:1; height:1px; background:linear-gradient(90deg,transparent,rgba(143,45,39,.34)); }\n.tk-jiyue-v2-promise { color:rgba(101,68,50,.76); font-family:'Palatino Linotype','Book Antiqua',Georgia,serif; font-size:.79em; font-style:italic; letter-spacing:.13em; white-space:nowrap; }\n.tk-jiyue-v2-helper { position:absolute; z-index:6; display:block; aspect-ratio:1; pointer-events:none; opacity:.76; background-image:var(--jy-helper-sprite); background-repeat:no-repeat; background-size:200% 200%; filter:sepia(.2) saturate(.72) contrast(.91); }\n.tk-jiyue-v2-helper-startled { top:35px; left:22px; width:72px; background-position:0 0; transform:rotate(-8deg); }\n.tk-jiyue-v2-helper-candy { top:24px; right:20px; width:88px; background-position:100% 0; transform:rotate(4deg); }\n.tk-jiyue-v2-helper-sleep { left:31%; bottom:4px; width:86px; background-position:0 100%; transform:rotate(2deg); }\n.tk-jiyue-v2-helper-repair { right:13px; bottom:-2px; width:82px; background-position:100% 100%; transform:rotate(-4deg); }\n.tk-jiyue-v2.mood-哀伤 { --jy-avatar:url(\"https://files.catbox.moe/58yxbd.png\"); }\n.tk-jiyue-v2.mood-安心 { --jy-avatar:url(\"https://files.catbox.moe/odpwjw.png\"); }\n.tk-jiyue-v2.mood-悲戚 { --jy-avatar:url(\"https://files.catbox.moe/vkynz9.png\"); }\n.tk-jiyue-v2.mood-担忧 { --jy-avatar:url(\"https://files.catbox.moe/k5sq42.png\"); }\n.tk-jiyue-v2.mood-咳嗽 { --jy-avatar:url(\"https://files.catbox.moe/663i11.png\"); }\n.tk-jiyue-v2.mood-害羞 { --jy-avatar:url(\"https://files.catbox.moe/k87wd8.png\"); }\n.tk-jiyue-v2.mood-惊讶 { --jy-avatar:url(\"https://files.catbox.moe/zwpxju.png\"); }\n.tk-jiyue-v2.mood-困惑 { --jy-avatar:url(\"https://files.catbox.moe/5oo7oy.png\"); }\n.tk-jiyue-v2.mood-陪伴 { --jy-avatar:url(\"https://files.catbox.moe/wy6mz7.png\"); }\n.tk-jiyue-v2.mood-期待 { --jy-avatar:url(\"https://files.catbox.moe/n2acs1.png\"); }\n.tk-jiyue-v2.mood-身体不适 { --jy-avatar:url(\"https://files.catbox.moe/8edqyd.png\"); }\n.tk-jiyue-v2.mood-失落 { --jy-avatar:url(\"https://files.catbox.moe/955id5.png\"); }\n.tk-jiyue-v2.mood-温婉 { --jy-avatar:url(\"https://files.catbox.moe/doavok.png\"); }\n.tk-jiyue-v2.mood-无奈 { --jy-avatar:url(\"https://files.catbox.moe/2d2of7.png\"); }\n.tk-jiyue-v2.mood-欣喜 { --jy-avatar:url(\"https://files.catbox.moe/qsnpy7.png\"); }\n.tk-jiyue-v2.mood-专注 { --jy-avatar:url(\"https://files.catbox.moe/nll9nm.png\"); }\n@media (max-width:660px) {\n  .tk-jiyue-v2 { margin:9px auto; padding:3.5px 7px; border-radius:5px; }\n  .tk-jiyue-v2-paper { min-height:0; padding:14.5px 17px 43px; clip-path:polygon(.7% 2%,14% .7%,30% 1.5%,47% .4%,65% 1.4%,83% .6%,99% 2.3%,99.4% 25%,98.9% 50%,99.5% 74%,98.5% 98%,79% 99.2%,59% 98.4%,39% 99.3%,19% 98.4%,.8% 97%,.4% 74%,1% 50%,.4% 25%); }\n  .tk-jiyue-v2-header { width:min(86%,380px); gap:10px; margin-bottom:4px; }\n  .tk-jiyue-v2-name { font-size:1.14em; }\n  .tk-jiyue-v2-content { grid-template-columns:1fr; justify-items:center; gap:4px; }\n  .tk-jiyue-v2-portrait { width:100px; height:100px; }\n  .tk-jiyue-v2-portrait-clip { inset:10px; }\n  .tk-jiyue-v2-dialogue { width:100%; box-sizing:border-box; min-height:0; padding:9px 16px 10px; font-size:1em; line-height:1.88; border-left:1px solid rgba(112,67,55,.36); border-top:2px solid rgba(205,83,70,.65); }\n  .tk-jiyue-v2-dialogue::before { top:-21px; left:3px; font-size:4.3em; }\n  .tk-jiyue-v2-thorn { top:64%; right:50%; width:min(78vw,330px); transform:translate(50%,-50%) rotate(-7deg); opacity:.055; }\n  .tk-jiyue-v2-footer { justify-content:center; margin:5px 68px 0 0; }\n  .tk-jiyue-v2-foot-rule { display:none; }\n  .tk-jiyue-v2-promise { font-size:.72em; }\n  .tk-jiyue-v2-helper-startled { top:28px; left:6px; width:56px; }\n  .tk-jiyue-v2-helper-candy { top:20px; right:4px; width:70px; }\n  .tk-jiyue-v2-helper-sleep { left:7px; bottom:8px; width:72px; }\n  .tk-jiyue-v2-helper-repair { right:2px; bottom:-3px; width:70px; }\n  .tk-jiyue-v2-tape-a { left:20%; }\n  .tk-jiyue-v2-tape-b { right:18%; }\n}\n</style>",
