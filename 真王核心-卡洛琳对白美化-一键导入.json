        "findRegex": "/<carolyn\\s+name=[\"'](.*?)[\"'](?:\\s+mood=[\"'](.*?)[\"'])?[^>]*>\\s*([\\s\\S]*?)\\s*<\\/carolyn>/gi",
        "trimStrings": [],
        "replaceString": "<div class=\"carolyn-wrapper\">\n  <div class=\"carolyn-vine vine-top\"></div>\n  <div class=\"carolyn-vine vine-right\"></div>\n  <div class=\"carolyn-vine vine-bottom\"></div>\n  <div class=\"carolyn-vine vine-left\"></div>\n  <div class=\"carolyn-vine-leaf leaf-tl\"></div>\n  <div class=\"carolyn-vine-leaf leaf-tr\"></div>\n  <div class=\"carolyn-vine-leaf leaf-bl\"></div>\n  <div class=\"carolyn-vine-leaf leaf-br\"></div>\n  <div class=\"carolyn-crystal c-top-left\">\n    <div class=\"crystal-shard cs1\"></div>\n    <div class=\"crystal-shard cs2\"></div>\n    <div class=\"crystal-shard cs3\"></div>\n  </div>\n  <div class=\"carolyn-crystal c-top-right\">\n    <div class=\"crystal-shard cs1\"></div>\n    <div class=\"crystal-shard cs2\"></div>\n    <div class=\"crystal-shard cs3\"></div>\n  </div>\n  <div class=\"carolyn-crystal c-bottom-left\">\n    <div class=\"crystal-shard cs1\"></div>\n    <div class=\"crystal-shard cs2\"></div>\n    <div class=\"crystal-shard cs3\"></div>\n  </div>\n  <div class=\"carolyn-crystal c-bottom-right\">\n    <div class=\"crystal-shard cs1\"></div>\n    <div class=\"crystal-shard cs2\"></div>\n    <div class=\"crystal-shard cs3\"></div>\n  </div>\n  \n  <div class=\"carolyn-border\">\n    <div class=\"carolyn-inner\">\n      <div class=\"carolyn-header\">\n        <div class=\"carolyn-header-line line-left\"></div>\n        <div class=\"carolyn-holy-symbol\">†</div>\n        <div class=\"carolyn-name\">$1</div>\n        <div class=\"carolyn-holy-symbol\">†</div>\n        <div class=\"carolyn-header-line line-right\"></div>\n      </div>\n\n      <div class=\"carolyn-content-row\">\n        <div class=\"carolyn-avatar-area\">\n          <div class=\"carolyn-avatar-ring mood-$2\">\n            <div class=\"carolyn-avatar mood-$2\"></div>\n          </div>\n        </div>\n\n        <div class=\"carolyn-text-column\">\n          <div class=\"carolyn-body\">$3</div>\n          <div class=\"carolyn-footer\">\n            <i><b>pone me ut signaculum super cor tuum</b></i>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap');\n\n.carolyn-wrapper {\n  position: relative;\n  margin: 28px 12px 20px 12px;\n  font-family: 'Noto Serif SC', 'Microsoft YaHei', serif;\n  z-index: 1;\n  filter: drop-shadow(0 4px 16px rgba(20, 40, 90, 0.5));\n}\n\n/* ========== 边框主体 ========== */\n.carolyn-border {\n  position: relative;\n  background: linear-gradient(160deg, \n    rgba(40, 60, 130, 0.7) 0%, \n    rgba(30, 45, 110, 0.65) 20%, \n    rgba(20, 35, 90, 0.8) 45%, \n    rgba(10, 20, 60, 0.9) 65%, \n    rgba(20, 35, 85, 0.8) 85%, \n    rgba(35, 55, 120, 0.7) 100%\n  );\n  padding: 2px;\n  clip-path: polygon(\n    20px 0, calc(100% - 20px) 0, \n    100% 20px, 100% calc(100% - 20px), \n    calc(100% - 20px) 100%, 20px 100%, \n    0 calc(100% - 20px), 0 20px\n  );\n  z-index: 2;\n}\n\n/* ========== 内部面板 ========== */\n.carolyn-inner {\n  background: linear-gradient(175deg, \n    rgba(6, 14, 35, 0.98) 0%, \n    rgba(10, 20, 48, 0.97) 40%, \n    rgba(4, 10, 30, 0.99) 100%\n  );\n  background-image: \n    radial-gradient(circle at 20% 30%, rgba(60, 100, 200, 0.06) 0%, transparent 50%),\n    radial-gradient(circle at 80% 70%, rgba(40, 80, 180, 0.04) 0%, transparent 50%);\n  clip-path: polygon(\n    18px 0, calc(100% - 18px) 0, \n    100% 18px, 100% calc(100% - 18px), \n    calc(100% - 18px) 100%, 18px 100%, \n    0 calc(100% - 18px), 0 18px\n  );\n  padding: 16px 20px 12px 20px;\n  position: relative;\n  display: flex;\n  flex-direction: column;\n}\n\n/* ========== 头部：名字区域（置顶居中） ========== */\n.carolyn-header {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 12px;\n  position: relative;\n  z-index: 5;\n  order: 1;\n}\n\n.carolyn-header-line {\n  flex-grow: 1;\n  height: 1px;\n  max-width: 80px;\n}\n.line-left  { background: linear-gradient(90deg, transparent, rgba(120, 150, 220, 0.5)); }\n.line-right { background: linear-gradient(270deg, transparent, rgba(120, 150, 220, 0.5)); }\n\n.carolyn-holy-symbol {\n  color: rgba(150, 180, 220, 0.6);\n  font-size: 10px;\n  padding: 0 6px;\n  text-shadow: 0 0 8px rgba(120, 160, 220, 0.4);\n  animation: holy-glow 2.5s ease-in-out infinite alternate;\n}\n\n@keyframes holy-glow {\n  0% { text-shadow: 0 0 6px rgba(120, 160, 220, 0.3); opacity: 0.6; }\n  100% { text-shadow: 0 0 12px rgba(160, 200, 240, 0.6); opacity: 1; }\n}\n\n.carolyn-name {\n  padding: 0 10px;\n  color: #c0d0f0;\n  font-family: 'Cinzel', 'Noto Serif SC', serif;\n  font-size: 1.05em;\n  font-weight: 600;\n  letter-spacing: 3px;\n  text-shadow: 0 0 10px rgba(100, 140, 200, 0.5);\n}\n\n/* ========== 内容行：头像 + 文本 ========== */\n.carolyn-content-row {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  order: 2;\n  flex: 1;\n}\n\n/* ========== 头像区域 ========== */\n.carolyn-content-row .carolyn-avatar-area {\n  flex-shrink: 0;\n  width: 120px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  margin-bottom: 0 !important;\n  z-index: 5;\n}\n\n.carolyn-avatar-ring {\n  width: 100px;\n  height: 100px;\n  border-radius: 50%;\n  padding: 3px;\n  background: linear-gradient(135deg, \n    rgba(180, 145, 80, 0.7) 0%, \n    rgba(130, 100, 50, 0.6) 30%, \n    rgba(220, 185, 110, 0.9) 50%, \n    rgba(110, 80, 40, 0.7) 70%, \n    rgba(180, 145, 80, 0.8) 100%\n  );\n  background-size: 200% 200%;\n  animation: ring-shimmer 4s ease-in-out infinite alternate;\n  box-shadow: \n    0 0 12px rgba(200, 160, 80, 0.4),\n    0 0 24px rgba(200, 160, 80, 0.15);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n@keyframes ring-shimmer {\n  0% { background-position: 0% 50%; }\n  100% { background-position: 100% 50%; }\n}\n\n.carolyn-avatar {\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  background-size: cover;\n  background-position: center top;\n  background-repeat: no-repeat;\n  background-image: url('https://i.ibb.co/bgNFSQrz/carolyn-confused.png');\n}\n\n/* 默认表情（温柔） */\n.carolyn-avatar:not([class*=\"mood-\"]) {\n  background-image: url('https://i.ibb.co/7Jyby7hj/carolyn-gentle.png');\n}\n\n/* 表情映射 */\n.mood-温柔 .carolyn-avatar { background-image: url('https://i.ibb.co/7Jyby7hj/carolyn-gentle.png'); }\n.mood-开心 .carolyn-avatar { background-image: url('https://i.ibb.co/nMCk5rRQ/carolyn-happy.png'); }\n.mood-俏皮 .carolyn-avatar { background-image: url('https://i.ibb.co/BVrdWjWC/carolyn-playful.png'); }\n.mood-坏笑 .carolyn-avatar { background-image: url('https://i.ibb.co/MDCYVdHT/carolyn-sly.png'); }\n.mood-微酸 .carolyn-avatar { background-image: url('https://i.ibb.co/s9qd0BYR/carolyn-pouty.png'); }\n.mood-肃然 .carolyn-avatar { background-image: url('https://i.ibb.co/9mHhh3Tc/carolyn-solemn.png'); }\n.mood-哀伤 .carolyn-avatar { background-image: url('https://i.ibb.co/zW4GmQ6G/carolyn-sorrowful.png'); }\n.mood-决意 .carolyn-avatar { background-image: url('https://i.ibb.co/V0ZxptW5/carolyn-resolved.png'); }\n.mood-骄傲 .carolyn-avatar { background-image: url('https://i.ibb.co/gbc7MRdN/carolyn-proud.png'); }\n.mood-忧虑 .carolyn-avatar { background-image: url('https://i.ibb.co/R4MvdRF4/carolyn-worried.png'); }\n.mood-祈祷 .carolyn-avatar { background-image: url('https://i.ibb.co/G4Bht1hv/carolyn-praying.png'); }\n.mood-惊讶 .carolyn-avatar { background-image: url('https://i.ibb.co/LdGBvLfQ/carolyn-surprised.png'); }\n.mood-害羞 .carolyn-avatar { background-image: url('https://i.ibb.co/whyd5hhq/carolyn-shy.png'); }\n.mood-困惑 .carolyn-avatar { background-image: url('https://i.ibb.co/bgNFSQrz/carolyn-confused.png'); }\n.mood-平静 .carolyn-avatar { background-image: url('https://i.ibb.co/pvYwqLgT/carolyn-serene.png'); }\n.mood-余韵 .carolyn-avatar { background-image: url('https://i.ibb.co/jvGKTWNN/carolyn-afterglow.png'); }\n.mood-恍惚 .carolyn-avatar { background-image: url('https://i.ibb.co/m5VvVCrV/carolyn-entranced.png'); }\n.mood-快感 .carolyn-avatar { background-image: url('https://i.ibb.co/v4pwR2F5/carolyn-euphoric.png'); }\n.mood-忍耐 .carolyn-avatar { background-image: url('https://i.ibb.co/Kj9YLZLb/carolyn-flushed.png'); }\n.mood-诱惑 .carolyn-avatar { background-image: url('https://i.ibb.co/tTS8hsG5/carolyn-temptation.png'); }\n\n/* ========== 右侧文本列 ========== */\n.carolyn-text-column {\n  flex-grow: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  min-width: 0;\n}\n\n/* ========== 对话正文 ========== */\n.carolyn-body {\n  color: #c8d4f0;\n  font-size: 1.02em;\n  line-height: 1.7;\n  text-align: left;\n  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);\n  white-space: pre-wrap;\n  word-break: break-word;\n  position: relative;\n  z-index: 5;\n  padding: 4px 8px;\n  margin: 6px 0;\n  border-left: 2px solid rgba(100, 140, 200, 0.3);\n  flex-shrink: 0;\n}\n\n/* ========== 底部签名（右下角） ========== */\n.carolyn-footer {\n  margin-top: 12px;\n  font-family: 'Cinzel', 'Times New Roman', serif;\n  font-size: 0.85em;\n  letter-spacing: 2px;\n  color: rgba(150, 170, 200, 0.5);\n  text-shadow: 0 0 6px rgba(120, 150, 190, 0.3);\n  font-style: italic;\n  font-weight: bold;\n  z-index: 5;\n  position: relative;\n  text-align: right;\n  align-self: flex-end;\n  transition: color 0.8s ease, text-shadow 0.8s ease;\n  padding-right: 4px;\n}\n\n.carolyn-footer:hover {\n  color: rgba(180, 200, 230, 0.8);\n  text-shadow: 0 0 14px rgba(150, 180, 220, 0.5);\n}\n\n/* ========== 金色藤蔓缠绕（外侧） ========== */\n.carolyn-vine {\n  position: absolute;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.vine-top {\n  top: -6px;\n  left: 28px;\n  right: 28px;\n  height: 3px;\n  background: linear-gradient(90deg,\n    transparent 0%,\n    rgba(180, 145, 80, 0.3) 5%,\n    rgba(220, 185, 110, 0.7) 15%,\n    rgba(200, 165, 95, 0.5) 30%,\n    rgba(230, 195, 120, 0.8) 50%,\n    rgba(200, 165, 95, 0.5) 70%,\n    rgba(220, 185, 110, 0.7) 85%,\n    rgba(180, 145, 80, 0.3) 95%,\n    transparent 100%\n  );\n  border-radius: 2px;\n  box-shadow: 0 0 8px rgba(220, 185, 110, 0.4), 0 1px 0 rgba(160, 130, 70, 0.3);\n  animation: vine-glow 4s ease-in-out infinite alternate;\n}\n\n.vine-bottom {\n  bottom: -6px;\n  left: 28px;\n  right: 28px;\n  height: 3px;\n  background: linear-gradient(90deg,\n    transparent 0%,\n    rgba(180, 145, 80, 0.3) 5%,\n    rgba(220, 185, 110, 0.7) 15%,\n    rgba(200, 165, 95, 0.5) 30%,\n    rgba(230, 195, 120, 0.8) 50%,\n    rgba(200, 165, 95, 0.5) 70%,\n    rgba(220, 185, 110, 0.7) 85%,\n    rgba(180, 145, 80, 0.3) 95%,\n    transparent 100%\n  );\n  border-radius: 2px;\n  box-shadow: 0 0 8px rgba(220, 185, 110, 0.4), 0 -1px 0 rgba(160, 130, 70, 0.3);\n  animation: vine-glow 4s ease-in-out infinite alternate-reverse;\n}\n\n.vine-right {\n  top: 28px;\n  bottom: 28px;\n  right: -6px;\n  width: 3px;\n  background: linear-gradient(180deg,\n    transparent 0%,\n    rgba(180, 145, 80, 0.3) 5%,\n    rgba(220, 185, 110, 0.7) 15%,\n    rgba(200, 165, 95, 0.5) 30%,\n    rgba(230, 195, 120, 0.8) 50%,\n    rgba(200, 165, 95, 0.5) 70%,\n    rgba(220, 185, 110, 0.7) 85%,\n    rgba(180, 145, 80, 0.3) 95%,\n    transparent 100%\n  );\n  border-radius: 2px;\n  box-shadow: 0 0 8px rgba(220, 185, 110, 0.4), -1px 0 0 rgba(160, 130, 70, 0.3);\n  animation: vine-glow 4s ease-in-out infinite alternate;\n}\n\n.vine-left {\n  top: 28px;\n  bottom: 28px;\n  left: -6px;\n  width: 3px;\n  background: linear-gradient(180deg,\n    transparent 0%,\n    rgba(180, 145, 80, 0.3) 5%,\n    rgba(220, 185, 110, 0.7) 15%,\n    rgba(200, 165, 95, 0.5) 30%,\n    rgba(230, 195, 120, 0.8) 50%,\n    rgba(200, 165, 95, 0.5) 70%,\n    rgba(220, 185, 110, 0.7) 85%,\n    rgba(180, 145, 80, 0.3) 95%,\n    transparent 100%\n  );\n  border-radius: 2px;\n  box-shadow: 0 0 8px rgba(220, 185, 110, 0.4), 1px 0 0 rgba(160, 130, 70, 0.3);\n  animation: vine-glow 4s ease-in-out infinite alternate-reverse;\n}\n\n@keyframes vine-glow {\n  0% { \n    opacity: 0.7;\n    filter: brightness(0.9);\n  }\n  100% { \n    opacity: 1;\n    filter: brightness(1.15);\n  }\n}\n\n/* ========== 藤蔓叶片点缀 ========== */\n.carolyn-vine-leaf {\n  position: absolute;\n  width: 10px;\n  height: 6px;\n  background: radial-gradient(ellipse at center, rgba(230, 195, 120, 0.9) 0%, rgba(180, 140, 70, 0.6) 60%, transparent 100%);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 1;\n  box-shadow: 0 0 6px rgba(220, 185, 110, 0.5);\n  animation: leaf-shimmer 3s ease-in-out infinite alternate;\n}\n\n.leaf-tl { top: -4px; left: 22px; transform: rotate(-30deg); animation-delay: 0s; }\n.leaf-tr { top: -4px; right: 22px; transform: rotate(30deg); animation-delay: 0.8s; }\n.leaf-bl { bottom: -4px; left: 22px; transform: rotate(30deg); animation-delay: 1.6s; }\n.leaf-br { bottom: -4px; right: 22px; transform: rotate(-30deg); animation-delay: 2.4s; }\n\n@keyframes leaf-shimmer {\n  0% { opacity: 0.5; transform: scale(0.9); }\n  100% { opacity: 0.9; transform: scale(1.15); }\n}\n\n/* ========== 破碎晶体（四角） ========== */\n.carolyn-crystal {\n  position: absolute;\n  z-index: 10;\n  pointer-events: none;\n}\n\n.c-top-left     { top: -8px;  left: -8px;  }\n.c-top-right    { top: -8px;  right: -8px; }\n.c-bottom-left  { bottom: -8px; left: -8px; }\n.c-bottom-right { bottom: -8px; right: -8px; }\n\n/* 晶体碎片 */\n.crystal-shard {\n  position: absolute;\n  background: linear-gradient(135deg, \n    rgba(60, 100, 200, 0.85) 0%, \n    rgba(40, 70, 160, 0.7) 30%, \n    rgba(25, 50, 140, 0.9) 60%, \n    rgba(15, 30, 100, 0.95) 100%\n  );\n  box-shadow: \n    inset 1px 1px 3px rgba(140, 180, 255, 0.4),\n    0 0 6px rgba(60, 100, 200, 0.5);\n  clip-path: polygon(30% 0%, 70% 0%, 100% 40%, 80% 100%, 20% 100%, 0% 40%);\n}\n\n/* 左上晶体 */\n.c-top-left .cs1 { width: 18px; height: 22px; top: 0;  left: 2px; transform: rotate(-15deg); animation: crystal-sway-1 3.5s ease-in-out infinite; }\n.c-top-left .cs2 { width: 12px; height: 16px; top: 4px; left: 14px; transform: rotate(10deg); animation: crystal-sway-2 4.2s ease-in-out infinite; }\n.c-top-left .cs3 { width: 10px; height: 14px; top: 12px; left: 0px; transform: rotate(-30deg); animation: crystal-sway-3 3.8s ease-in-out infinite; }\n\n/* 右上晶体 */\n.c-top-right .cs1 { width: 20px; height: 24px; top: 0;  right: 2px; transform: rotate(15deg); animation: crystal-sway-2 4.0s ease-in-out infinite; }\n.c-top-right .cs2 { width: 14px; height: 18px; top: 3px; right: 16px; transform: rotate(-12deg); animation: crystal-sway-1 3.3s ease-in-out infinite; }\n.c-top-right .cs3 { width: 10px; height: 13px; top: 14px; right: 0px; transform: rotate(25deg); animation: crystal-sway-3 4.5s ease-in-out infinite; }\n\n/* 左下晶体 */\n.c-bottom-left .cs1 { width: 16px; height: 20px; bottom: 0; left: 2px; transform: rotate(20deg); animation: crystal-sway-3 3.7s ease-in-out infinite; }\n.c-bottom-left .cs2 { width: 13px; height: 17px; bottom: 3px; left: 14px; transform: rotate(-8deg); animation: crystal-sway-1 4.1s ease-in-out infinite; }\n.c-bottom-left .cs3 { width: 9px; height: 12px; bottom: 12px; left: 0px; transform: rotate(-25deg); animation: crystal-sway-2 3.9s ease-in-out infinite; }\n\n/* 右下晶体 */\n.c-bottom-right .cs1 { width: 19px; height: 23px; bottom: 0; right: 2px; transform: rotate(-18deg); animation: crystal-sway-2 3.6s ease-in-out infinite; }\n.c-bottom-right .cs2 { width: 13px; height: 16px; bottom: 4px; right: 15px; transform: rotate(14deg); animation: crystal-sway-3 4.3s ease-in-out infinite; }\n.c-bottom-right .cs3 { width: 10px; height: 14px; bottom: 13px; right: 0px; transform: rotate(-28deg); animation: crystal-sway-1 3.4s ease-in-out infinite; }\n\n/* 晶体晃动动画 */\n@keyframes crystal-sway-1 {\n  0%, 100% { transform: rotate(-15deg) translateX(0); }\n  25% { transform: rotate(-13deg) translateX(1.5px); }\n  75% { transform: rotate(-17deg) translateX(-1.5px); }\n}\n@keyframes crystal-sway-2 {\n  0%, 100% { transform: rotate(10deg) translateX(0); }\n  30% { transform: rotate(12deg) translateX(-1px); }\n  70% { transform: rotate(8deg) translateX(1px); }\n}\n@keyframes crystal-sway-3 {\n  0%, 100% { transform: rotate(-20deg) translateX(0); }\n  40% { transform: rotate(-18deg) translateX(1px); }\n  60% { transform: rotate(-22deg) translateX(-1px); }\n}\n\n/* ========== 响应式（手机端） ========== */\n@media only screen and (max-width: 600px) {\n  .carolyn-wrapper { margin: 20px 10px 14px 10px; }\n  .carolyn-inner { padding: 12px 10px 8px 10px; }\n\n  .carolyn-content-row {\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .carolyn-content-row .carolyn-avatar-area {\n    width: auto;\n    margin-bottom: 8px !important;\n  }\n\n  .carolyn-avatar-ring { width: 80px; height: 80px; padding: 2px; }\n\n  .carolyn-text-column {\n    align-items: center;\n    width: 100%;\n  }\n\n  .carolyn-body {\n    font-size: 0.95em;\n    padding: 2px 6px;\n    border-left: none;\n    border-top: 2px solid rgba(100, 140, 200, 0.3);\n    padding-top: 8px;\n    margin-top: 0;\n  }\n\n  .carolyn-footer {\n    font-size: 0.75em;\n    letter-spacing: 1px;\n    text-align: center;\n    align-self: center;\n    padding-right: 0;\n  }\n\n  .carolyn-name { font-size: 0.95em; letter-spacing: 2px; }\n  \n  .vine-top { left: 22px; right: 22px; height: 2px; }\n  .vine-bottom { left: 22px; right: 22px; height: 2px; }\n  .vine-right { top: 22px; bottom: 22px; width: 2px; }\n  .vine-left { top: 22px; bottom: 22px; width: 2px; }\n  \n  .leaf-tl { left: 16px; }\n  .leaf-tr { right: 16px; }\n  .leaf-bl { left: 16px; }\n  .leaf-br { right: 16px; }\n  \n  .c-top-left .cs1, .c-top-right .cs1, .c-bottom-left .cs1, .c-bottom-right .cs1 { width: 14px; height: 17px; }\n  .c-top-left .cs2, .c-top-right .cs2, .c-bottom-left .cs2, .c-bottom-right .cs2 { width: 9px; height: 12px; }\n  .c-top-left .cs3, .c-top-right .cs3, .c-bottom-left .cs3, .c-bottom-right .cs3 { width: 7px; height: 10px; }\n}\n</style>",
