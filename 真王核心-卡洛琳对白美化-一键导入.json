    {
        "id": "ab1882f9-0f20-48f0-a24f-462da0bd81d1",
        "scriptName": "真王系统-虚空武装展示美化",
        "disabled": false,
        "runOnEdit": true,
        "findRegex": "/<void_armament\\s+name=[\"'](.*?)[\"']\\s+origin=[\"'](.*?)[\"']\\s+atk=[\"'](.*?)[\"']\\s+source=[\"'](.*?)[\"']\\s+skill1_name=[\"'](.*?)[\"']\\s+skill1_effect=[\"'](.*?)[\"']\\s+skill2_name=[\"'](.*?)[\"']\\s+skill2_effect=[\"'](.*?)[\"']\\s+skill3_name=[\"'](.*?)[\"']\\s+skill3_effect=[\"'](.*?)[\"']\\s+skill4_name=[\"'](.*?)[\"']\\s+skill4_effect=[\"'](.*?)[\"']\\s+description=[\"'](.*?)[\"']\\s+scripture=[\"'](.*?)[\"'][^>]*>/gi",
        "trimStrings": [],
        "replaceString": "<div class=\"va-wrapper va-theme-$2\">\n  <div class=\"va-glow-ring\"></div>\n  <div class=\"va-glow-ring va-glow-ring-outer\"></div>\n\n  <div class=\"va-gem\">\n    <div class=\"va-gem-inner\">\n      \n      <div class=\"va-header\">\n        <span class=\"va-header-deco\">◆</span>\n        <span class=\"va-header-label\">虚空武装</span>\n        <span class=\"va-header-deco\">◆</span>\n      </div>\n\n      <div class=\"va-name-row\">\n        <span class=\"va-name-deco\">✧</span>\n        <span class=\"va-name\">$1</span>\n        <span class=\"va-name-deco\">✧</span>\n      </div>\n\n      <div class=\"va-meta-row\">\n        <span class=\"va-origin\">$2</span>\n        <span class=\"va-atk\">$3</span>\n      </div>\n      <div class=\"va-source\">来源：$4</div>\n\n      <div class=\"va-skills-section\">\n        <div class=\"va-skill-item\">\n          <span class=\"va-skill-name\">$5</span>\n          <span class=\"va-skill-effect\">$6</span>\n        </div>\n        <div class=\"va-skill-item\">\n          <span class=\"va-skill-name\">$7</span>\n          <span class=\"va-skill-effect\">$8</span>\n        </div>\n        <div class=\"va-skill-item\">\n          <span class=\"va-skill-name\">$9</span>\n          <span class=\"va-skill-effect\">$10</span>\n        </div>\n        <div class=\"va-liberation\">\n          <div class=\"va-liberation-glow-bg\"></div>\n          <div class=\"va-liberation-header\">\n            <span class=\"va-liberation-star\">★</span>\n            <span class=\"va-liberation-label\">解 放</span>\n            <span class=\"va-liberation-star\">★</span>\n          </div>\n          <div class=\"va-liberation-name\">$11</div>\n          <div class=\"va-liberation-effect\">$12</div>\n        </div>\n      </div>\n\n      <div class=\"va-desc\">$13</div>\n      <div class=\"va-scripture\">$14</div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap');\n\n.va-wrapper {\n  position: relative;\n  margin: 28px 12px;\n  font-family: 'Noto Serif SC', 'Microsoft YaHei', serif;\n  z-index: 1;\n}\n\n/* ===== 流动光效环 ===== */\n.va-glow-ring {\n  position: absolute;\n  inset: -4px;\n  border-radius: 18px;\n  padding: 4px;\n  background: var(--va-glow-grad);\n  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  -webkit-mask-composite: xor;\n  mask-composite: exclude;\n  animation: va-ring-rotate 8s linear infinite;\n  pointer-events: none;\n}\n.va-glow-ring-outer {\n  inset: -8px;\n  padding: 8px;\n  opacity: 0.4;\n  animation-duration: 12s;\n  animation-direction: reverse;\n}\n@keyframes va-ring-rotate {\n  0% { filter: hue-rotate(0deg) brightness(1); }\n  50% { filter: hue-rotate(15deg) brightness(1.2); }\n  100% { filter: hue-rotate(0deg) brightness(1); }\n}\n\n/* ===== 宝石主体 ===== */\n.va-gem {\n  position: relative;\n  background: var(--va-gem-bg);\n  border-radius: 14px;\n  box-shadow:\n    inset 0 0 60px var(--va-gem-shimmer),\n    0 8px 32px rgba(0,0,0,0.6);\n  overflow: hidden;\n  z-index: 2;\n}\n.va-gem::before {\n  content: '';\n  position: absolute;\n  top: -30%;\n  left: -10%;\n  width: 60%;\n  height: 80%;\n  background: radial-gradient(ellipse at 50% 50%, var(--va-gem-facet) 0%, transparent 70%);\n  transform: rotate(-15deg);\n  pointer-events: none;\n  z-index: 0;\n}\n.va-gem::after {\n  content: '';\n  position: absolute;\n  bottom: -20%;\n  right: -5%;\n  width: 50%;\n  height: 60%;\n  background: radial-gradient(ellipse at 50% 50%, var(--va-gem-facet) 0%, transparent 70%);\n  transform: rotate(20deg);\n  pointer-events: none;\n  z-index: 0;\n}\n\n.va-gem-inner {\n  position: relative;\n  z-index: 1;\n  padding: 22px 24px 18px 24px;\n  background: var(--va-gem-overlay);\n}\n\n/* ===== 头部 ===== */\n.va-header {\n  text-align: center;\n  margin-bottom: 6px;\n}\n.va-header-deco {\n  color: var(--va-accent-muted);\n  font-size: 7px;\n  padding: 0 10px;\n  opacity: 0.7;\n}\n.va-header-label {\n  color: var(--va-accent-muted);\n  font-size: 0.6em;\n  letter-spacing: 8px;\n  text-transform: uppercase;\n}\n\n.va-name-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 4px;\n}\n.va-name-deco {\n  color: var(--va-accent);\n  font-size: 12px;\n  padding: 0 10px;\n  animation: va-star-glow 2.5s ease-in-out infinite alternate;\n}\n@keyframes va-star-glow {\n  0% { text-shadow: 0 0 4px var(--va-glow-color); opacity: 0.4; }\n  100% { text-shadow: 0 0 16px var(--va-glow-color); opacity: 1; }\n}\n.va-name {\n  font-family: 'Cinzel', 'Noto Serif SC', serif;\n  font-size: 1.25em;\n  font-weight: 700;\n  color: var(--va-accent);\n  letter-spacing: 4px;\n  text-shadow: 0 0 16px var(--va-glow-color);\n}\n\n.va-meta-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7em;\n  color: var(--va-accent-muted);\n  letter-spacing: 2px;\n  margin-bottom: 2px;\n  padding: 0 4px;\n}\n.va-source {\n  text-align: right;\n  font-size: 0.65em;\n  color: var(--va-accent-muted);\n  font-style: italic;\n  letter-spacing: 1px;\n  margin-bottom: 14px;\n}\n\n/* ===== 技能区 ===== */\n.va-skills-section {\n  margin-bottom: 8px;\n}\n.va-skill-item {\n  margin-bottom: 8px;\n  font-size: 0.88em;\n  line-height: 1.5;\n  padding: 4px 0;\n}\n.va-skill-name {\n  color: var(--va-accent);\n  font-weight: 600;\n  display: block;\n  margin-bottom: 2px;\n}\n.va-skill-effect {\n  color: #d0d8f0;\n  display: block;\n  padding-left: 10px;\n  border-left: 2px solid var(--va-accent-muted);\n}\n\n/* ===== 解放技能 ===== */\n.va-liberation {\n  position: relative;\n  margin-top: 14px;\n  padding: 16px 14px;\n  border-radius: 8px;\n  border: 1px solid var(--va-accent);\n  background: var(--va-liberation-bg);\n  overflow: hidden;\n}\n.va-liberation-glow-bg {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(ellipse at 50% 0%, var(--va-liberation-glow) 0%, transparent 65%);\n  opacity: 0.5;\n  animation: va-liberation-pulse 3s ease-in-out infinite;\n  pointer-events: none;\n}\n@keyframes va-liberation-pulse {\n  0%,100% { opacity: 0.3; transform: scale(1); }\n  50% { opacity: 0.7; transform: scale(1.05); }\n}\n.va-liberation-header {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 6px;\n  position: relative;\n  z-index: 1;\n}\n.va-liberation-star {\n  color: var(--va-accent);\n  font-size: 10px;\n  padding: 0 8px;\n  animation: va-star-glow 2s ease-in-out infinite alternate;\n}\n.va-liberation-label {\n  color: var(--va-accent);\n  font-size: 0.78em;\n  letter-spacing: 6px;\n  font-weight: 600;\n}\n.va-liberation-name {\n  font-family: 'Cinzel', 'Noto Serif SC', serif;\n  font-size: 1em;\n  font-weight: 700;\n  color: var(--va-accent);\n  text-align: center;\n  letter-spacing: 2px;\n  text-shadow: 0 0 14px var(--va-glow-color);\n  margin-bottom: 6px;\n  position: relative;\n  z-index: 1;\n}\n.va-liberation-effect {\n  font-size: 0.88em;\n  color: #f0e6c0;\n  line-height: 1.6;\n  text-align: center;\n  position: relative;\n  z-index: 1;\n}\n\n/* ===== 描述与经文 ===== */\n.va-desc {\n  margin-top: 14px;\n  font-size: 0.8em;\n  color: #b0bdd0;\n  font-style: italic;\n  line-height: 1.7;\n  text-align: center;\n  padding: 0 6px;\n}\n.va-scripture {\n  text-align: center;\n  font-size: 0.72em;\n  color: var(--va-accent-muted);\n  font-style: italic;\n  letter-spacing: 1px;\n  line-height: 1.8;\n  padding: 10px 8px 0 8px;\n  margin-top: 10px;\n  border-top: 1px solid var(--va-accent-muted);\n  font-family: 'Cinzel', 'Noto Serif SC', serif;\n}\n\n/* ===== 色彩主题 ===== */\n/* 圣经（暗蓝金） */\n.va-theme-圣经 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #d4af37, transparent, #d4af37, transparent);\n  --va-gem-bg: linear-gradient(160deg, #060e20 0%, #0a1530 30%, #0d1a3a 60%, #060e20 100%);\n  --va-gem-shimmer: rgba(180,150,80,0.08);\n  --va-gem-facet: rgba(180,150,80,0.06);\n  --va-gem-overlay: rgba(6,14,32,0.3);\n  --va-accent: #d4af37;\n  --va-accent-muted: rgba(180,145,90,0.6);\n  --va-glow-color: rgba(220,190,120,0.6);\n  --va-liberation-bg: rgba(180,150,80,0.06);\n  --va-liberation-glow: rgba(220,190,120,0.3);\n}\n\n/* 荷马史诗/伊利亚特/奥德赛（暗铜色） */\n.va-theme-荷马史诗, .va-theme-伊利亚特, .va-theme-奥德赛 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #c89050, transparent, #c89050, transparent);\n  --va-gem-bg: linear-gradient(160deg, #1a0e06 0%, #28180a 30%, #1a0e06 60%, #120a04 100%);\n  --va-gem-shimmer: rgba(200,140,80,0.08);\n  --va-gem-facet: rgba(200,140,80,0.06);\n  --va-gem-overlay: rgba(26,14,6,0.3);\n  --va-accent: #c89050;\n  --va-accent-muted: rgba(180,120,70,0.6);\n  --va-glow-color: rgba(220,150,80,0.5);\n  --va-liberation-bg: rgba(180,120,60,0.06);\n  --va-liberation-glow: rgba(220,150,80,0.3);\n}\n\n/* 埃达（暗冰蓝） */\n.va-theme-埃达 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #8ab8d0, transparent, #8ab8d0, transparent);\n  --va-gem-bg: linear-gradient(160deg, #050e1a 0%, #0a1828 30%, #050e1a 60%, #030a14 100%);\n  --va-gem-shimmer: rgba(140,180,200,0.08);\n  --va-gem-facet: rgba(140,180,200,0.06);\n  --va-gem-overlay: rgba(5,14,26,0.3);\n  --va-accent: #8ab8d0;\n  --va-accent-muted: rgba(120,160,180,0.6);\n  --va-glow-color: rgba(140,180,210,0.5);\n  --va-liberation-bg: rgba(100,150,180,0.05);\n  --va-liberation-glow: rgba(140,180,210,0.3);\n}\n\n/* 摩诃婆罗多/罗摩衍那（暗朱红） */\n.va-theme-摩诃婆罗多, .va-theme-罗摩衍那 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #c87050, transparent, #c87050, transparent);\n  --va-gem-bg: linear-gradient(160deg, #1a0806 0%, #28100a 30%, #1a0806 60%, #120504 100%);\n  --va-gem-shimmer: rgba(200,100,70,0.08);\n  --va-gem-facet: rgba(200,100,70,0.06);\n  --va-gem-overlay: rgba(26,8,6,0.3);\n  --va-accent: #c87050;\n  --va-accent-muted: rgba(180,100,70,0.6);\n  --va-glow-color: rgba(220,120,80,0.5);\n  --va-liberation-bg: rgba(180,90,60,0.06);\n  --va-liberation-glow: rgba(220,120,80,0.3);\n}\n\n/* 卡勒瓦拉（暗松绿） */\n.va-theme-卡勒瓦拉 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #7ab88a, transparent, #7ab88a, transparent);\n  --va-gem-bg: linear-gradient(160deg, #05120a 0%, #081e10 30%, #05120a 60%, #030d06 100%);\n  --va-gem-shimmer: rgba(120,180,130,0.08);\n  --va-gem-facet: rgba(120,180,130,0.06);\n  --va-gem-overlay: rgba(5,18,10,0.3);\n  --va-accent: #7ab88a;\n  --va-accent-muted: rgba(100,150,120,0.6);\n  --va-glow-color: rgba(120,180,140,0.5);\n  --va-liberation-bg: rgba(80,150,100,0.05);\n  --va-liberation-glow: rgba(120,180,140,0.3);\n}\n\n/* 列王纪（暗波斯蓝） */\n.va-theme-列王纪 {\n  --va-glow-grad: conic-gradient(from 0deg, transparent, #5078c8, transparent, #5078c8, transparent);\n  --va-gem-bg: linear-gradient(160deg, #050a1e 0%, #0a1230 30%, #050a1e 60%, #030614 100%);\n  --va-gem-shimmer: rgba(80,120,200,0.08);\n  --va-gem-facet: rgba(80,120,200,0.06);\n  --va-gem-overlay: rgba(5,10,30,0.3);\n  --va-accent: #5078c8;\n  --va-accent-muted: rgba(70,100,170,0.6);\n  --va-glow-color: rgba(80,120,200,0.5);\n  --va-liberation-bg: rgba(60,90,170,0.06);\n  --va-liberation-glow: rgba(80,120,200,0.3);\n}\n\n/* ===== 响应式 ===== */\n@media only screen and (max-width: 600px) {\n  .va-gem-inner { padding: 14px 10px 10px 10px; }\n  .va-name { font-size: 1.05em; letter-spacing: 2px; }\n  .va-meta-row { flex-direction: column; text-align: center; gap: 2px; }\n  .va-skill-item { font-size: 0.82em; }\n  .va-liberation { padding: 12px 8px; }\n  .va-liberation-name { font-size: 0.9em; }\n  .va-liberation-effect { font-size: 0.82em; }\n  .va-desc { font-size: 0.75em; }\n  .va-scripture { font-size: 0.68em; }\n}\n</style>",
